# Optional: add your API key for open-ended conversations.
# The chatbot works without this — rule-based replies still function.
OPENAI_API_KEY=your_key_here

# Optional: override the API base URL if you are using a compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# Port for the web server (default: 3000)
PORT=3000
